# Force EAS to run prebuild from app.config.js (lite vs full package, New Arch, ABIs).
# Without this, the committed android/ folder overrides variant settings.
android/
ios/

.expo/
dist/
coverage/
*.log
**/*.test.ts
**/*.test.tsx

# .easignore replaces .gitignore for the upload. Keep local secrets off the builder
# or production-lite bakes pk_test_ and then crashes (CLERK_KEY_MODE=live).
.env
.env.*
!.env.example

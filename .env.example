# Copy to `.env` (gitignored) and adjust.

# ── Switch (only change this for day-to-day) ─────────────────────────
# production → https://api.jevahapp.com
# local      → localhost / emulator host (see below)
EXPO_PUBLIC_API_ENV=production

# ── Optional URL overrides ───────────────────────────────────────────
# EXPO_PUBLIC_API_URL_PRODUCTION=https://api.jevahapp.com
#
# Local defaults:
#   iOS Simulator:      http://localhost:4000
#   Android Emulator:   http://10.0.2.2:4000
# Physical device: set your machine LAN IP, e.g.
# EXPO_PUBLIC_API_URL_LOCAL=http://192.168.1.10:4000

# Legacy (still used as production URL when EXPO_PUBLIC_API_ENV=production):
# EXPO_PUBLIC_API_URL=https://api.jevahapp.com

# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

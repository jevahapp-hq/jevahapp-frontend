ngSignup.test.ts app/utils/pickAuthSession.test.ts app/services/reportMediaId.test.ts",
    "run-prod-bundle": "npx expo start --no-dev",
    "build": "eas build --profile preview --platform android --non-interactive",
    "configure": "eas build:configure",
    "a-local": "eas build --platform android --local",
    "i-local": "eas build --platform ios --local",
    "bpa": "eas build --profile preview --platform android --non-interactive",
    "bda": "eas build --profile development --platform android",
    "bota": "eas build --profile ota-preview --platform android",
    "bpra": "eas build --profile production --platform android --non-interactive",
    "bpra-lite": "eas build --profile production-lite --platform android",
    "bplay": "eas build --profile playstore --platform android --non-interactive",
    "bplay-lite": "eas build --profile playstore-lite --platform android --non-interactive",
    "bpi": "eas build --profile preview --platform ios --non-interactive",
    "bpia": "eas build --profile production-ios --platform ios --non-interactive",
    "bpia-lite": "eas build --profile production-ios-lite --platform ios --non-interactive",
    "btf": "eas build --profile testflight --platform ios --non-interactive",
    "bappstore": "eas build --profile appstore --platform ios --non-interactive",
    "bpri": "eas build --profile testflight --platform ios --non-interactive",
    "bis": "eas build --profile ios-test --platform ios --non-interactive",
    "submit-ios": "eas submit -p ios --profile testflight",
    "submit-android": "eas submit -p android --profile playstore",
    "build-local": "eas build --profile preview --platform android --local",
    "upgrade-eas": "npm install -g eas-cli",
    "upgrade-dependencies": "npx expo install --fix",
    "rebuild-dev-client": "npx expo prebuild --clean",
    "prebuild": "npx expo prebuild",
    "pod-install": "cd ios && pod install --repo-update",
    "expo-latest": "npx expo install expo@latest",
    "install-compatible": "npx expo install --check",
    "ota-prod": "eas update --branch production --environment production",
    "ota-prev": "eas update --branch preview --environment preview",
    "ota-dev": "eas update --branch development --environment development --message 'Development update'"
  },
